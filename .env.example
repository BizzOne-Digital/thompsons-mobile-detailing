# Required for production (Vercel: set for Production + Preview)
# Canonical domain for sitemap, robots, Open Graph, and JSON-LD — must be www.tmdaz.com
NEXT_PUBLIC_SITE_URL=https://www.tmdaz.com
MONGODB_URI=
AUTH_SECRET=

# One-time first admin (optional if using SEED_ADMIN_* below)
ADMIN_SETUP_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com
# SMTP_PASS=Google App Password (not your normal login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKING_NOTIFICATION_EMAIL=thompsonsdetailing1@gmail.com

# npm run seed — creates services, FAQs, and upserts admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Thompson Admin

# Live Google reviews on homepage (Places API — refreshes hourly)
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# First-time promo popup + booking codes (public)
NEXT_PUBLIC_PROMO_ENABLED=true
NEXT_PUBLIC_PROMO_CODE=WELCOME10
NEXT_PUBLIC_PROMO_PERCENT=10
NEXT_PUBLIC_PROMO_HEADLINE=10% off your first detail
NEXT_PUBLIC_PROMO_TERMS=New customers only. One use per household. Mention code when booking. Not valid with other offers.
NEXT_PUBLIC_PROMO_DELAY_MS=8000

# Optional remarketing (cookie banner shown when set)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
